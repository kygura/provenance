# Required: the LLM that does the provenance research.
ANTHROPIC_API_KEY=

# Trending sources. All optional - with none of these set the pipeline still runs
# on DexScreener + GeckoTerminal, both of which are keyless.
DEXTOOLS_API_KEY=

# Holder distribution. Optional, but without them the distribution section is blank.
HELIUS_API_KEY=          # Solana holder distribution
ETHERSCAN_API_KEY=       # EVM holder distribution (Etherscan V2 multichain key)
BIRDEYE_API_KEY=         # fallback for Solana holders

# Alerts. Set any subset; each one that is configured gets the digest.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# GITHUB_TOKEN / GITHUB_REPOSITORY are injected by Actions; set them locally only
# if you want `--alert github` to open issues from your machine.
