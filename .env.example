# Provenance configuration.
#
# No paid market-data API key is needed anywhere. DexScreener and GeckoTerminal
# publish free keyless endpoints.
# The LLM key is the only paid credential: one provider's key is enough (see LLM).

# ---------------------------------------------------------------------------
# Required for a live run
# ---------------------------------------------------------------------------

# The key for whichever provider LLM_MODEL names (see LLM below). Without it
# the pipeline still collects market and on-chain data, but provenance reports
# degrade to offline stubs.
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (sk-ant-usr-...): the workspace to bill.
ANTHROPIC_WORKSPACE_ID=

# libSQL/Turso for production, or a local SQLite file for development.
DATABASE_URL=file:./data/provenance.db
# Required for libsql:// URLs only. Give the dashboard's copy read-only scope.
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Alert channels — all optional; console output is always on
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
# Appends every alert as JSONL. Useful as a CI artifact.
ALERT_FILE_SINK=

# ---------------------------------------------------------------------------
# Pipeline tuning — all optional, defaults shown
# ---------------------------------------------------------------------------

# Comma-separated; blank means every supported chain.
PROVENANCE_CHAINS=
# Tokens that get the full chain + LLM treatment each run.
MAX_TOKENS_PER_RUN=15
MIN_LIQUIDITY_USD=25000
MIN_VOLUME_24H_USD=100000
# Younger pools have no provenance worth researching yet.
MIN_POOL_AGE_HOURS=2
# Reuse a stored report inside this window; what keeps twice-daily runs cheap.
REANALYSE_AFTER_HOURS=72
ALERT_SCORE_THRESHOLD=70
DRY_RUN=false
# Run entirely from fixtures: no network, no API key.
USE_FIXTURES=false
LOG_LEVEL=info
PROVENANCE_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Sources — toggles and per-source limits
# ---------------------------------------------------------------------------

SOURCE_DEXSCREENER=true
SOURCE_DEXSCREENER_LIMIT=30
SOURCE_DEXSCREENER_RATE_MS=1200
SOURCE_GECKOTERMINAL=true
SOURCE_GECKOTERMINAL_LIMIT=30
SOURCE_GECKOTERMINAL_RATE_MS=2200

# ---------------------------------------------------------------------------
# Social yardstick — optional (docs/social.md)
# ---------------------------------------------------------------------------

# Elfa's trending contract-address feeds (X and Telegram), recorded as
# sightings and matched against the watchlist to measure how far ahead of
# crypto-social each verdict was. Not a verdict or score input. Blank = off.
ELFA_API_KEY=

# Exa search: the search tool for Kimi and every other non-Anthropic model.
EXA_API_KEY=
# Minimum hours between fetches, across runs. Two feeds at one credit each
# every 2h is ~720 credits a month, inside the free plan's 1,000 with room for
# hypertrade's collector (~90) on the same key.
ELFA_MIN_INTERVAL_HOURS=2
# Elfa's minMentions: contracts below it are not returned.
ELFA_MIN_MENTIONS=5
# Rows per feed per fetch; one page is one credit.
ELFA_PAGE_SIZE=50
# twitter,telegram (blank = both)
ELFA_PLATFORMS=
ELFA_RATE_MS=1100

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------

# Models are "provider:model", or a bare id whose provider is inferred
# (claude-* -> anthropic, gpt-* -> openai, kimi-* -> moonshot, qwen* -> qwen,
# deepseek-* -> deepseek, org/model -> openrouter).
#
#   provider           key                        web search in the research pass
#   anthropic          ANTHROPIC_API_KEY          server web_search tool
#   openai             OPENAI_API_KEY             Responses API web_search
#   openrouter         OPENROUTER_API_KEY         web plugin, any routed model; reports billed cost
#   moonshot (Kimi)    MOONSHOT_API_KEY           $web_search builtin (default: Exa, below)
#   qwen               DASHSCOPE_API_KEY          enable_search (Alibaba Model Studio)
#   deepseek           DEEPSEEK_API_KEY           none: answers from recall, scored as ungrounded
#   openai-compatible  OPENAI_COMPATIBLE_API_KEY  none; needs OPENAI_COMPATIBLE_BASE_URL
#
# Blank model vars mean Kimi on Moonshot (MOONSHOT_API_KEY): K3 researches,
# K2.6 extracts and runs the anchor check.
#
# LLM_ANTHROPIC_FIRST=true (with ANTHROPIC_API_KEY) moves every role that names
# another provider onto its Anthropic default instead (research and extract
# claude-opus-5, triage claude-sonnet-5). Off by default: Opus costs about twice
# what Kimi does per report.
LLM_ANTHROPIC_FIRST=
#
# With EXA_API_KEY set, every non-Anthropic model searches through Exa instead
# of its provider's tool: a `web_search` function with publish dates and a
# "published before" bound, and every page shown counts as a citation. Set
# LLM_SEARCH_BACKEND=native to use the provider's own search.
LLM_SEARCH_BACKEND=exa
#
# Research model: searches the web and writes notes.
LLM_MODEL=moonshot:kimi-k3
# Extraction model: turns the notes into the typed report. No search, so a cheap
# model is fine here.
LLM_EXTRACT_MODEL=moonshot:kimi-k2.6
# Fast anchor check on every launch that clears the gate.
LLM_TRIAGE_MODEL=moonshot:kimi-k2.6
# Anthropic models and Kimi K2.6/K3 are priced out of the box. Any other model needs a price
# here, or the run refuses to start, since LLM_MAX_COST_USD_PER_RUN could not be
# enforced. OpenRouter is exempt: it reports what each call cost.
#   LLM_PRICING=gpt-5.4-mini=0.75/4.5,kimi-k2-0905-preview=0.6/2.5   (USD per 1M input/output tokens)
LLM_PRICING=
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2
# Hard ceiling per run. Once hit, market and chain data keep being collected
# and the model stops being called. Start low.
LLM_MAX_COST_USD_PER_RUN=5
# Server-side web searches per token in the research pass. The single biggest
# lever on both cost and research depth: six is enough to date a meme and find
# two prior cycles without wandering.
LLM_MAX_WEB_SEARCHES=6

# Keys for the other providers; set only the ones you use.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# Base URL overrides, e.g. MOONSHOT_BASE_URL=https://api.moonshot.cn/v1 for the China endpoint.
# OPENAI_BASE_URL= OPENROUTER_BASE_URL= MOONSHOT_BASE_URL= DEEPSEEK_BASE_URL= ANTHROPIC_BASE_URL=
# DASHSCOPE_BASE_URL defaults to the international (Singapore) compatible-mode endpoint;
# e.g. https://dashscope-us.aliyuncs.com/compatible-mode/v1 for Virginia.

# ---------------------------------------------------------------------------
# RPC endpoints — comma-separated, tried in order. Defaults are free public
# endpoints; supply your own if you have better ones. Your list leads and the
# public defaults are appended as fallbacks unless RPC_PUBLIC_FALLBACK=false.
# ---------------------------------------------------------------------------

# RPC_PUBLIC_FALLBACK=true

RPC_SOLANA=https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com
RPC_BASE=https://mainnet.base.org
RPC_BSC=https://bsc-dataseed.binance.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_POLYGON=https://polygon-rpc.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
