# Provenance configuration.
#
# No paid market-data API key is needed anywhere. DexScreener and GeckoTerminal
# publish free keyless endpoints, and DexTools is scraped with Playwright.
# ANTHROPIC_API_KEY is the only paid credential in the system.

# ---------------------------------------------------------------------------
# Required for a live run
# ---------------------------------------------------------------------------

# Only paid credential. Without it the pipeline still collects market and
# on-chain data, but provenance reports degrade to offline stubs.
ANTHROPIC_API_KEY=

# libSQL/Turso for production, or a local SQLite file for development.
DATABASE_URL=file:./data/provenance.db
# Required for libsql:// URLs only. Give the dashboard's copy read-only scope.
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Alert channels — all optional; console output is always on
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
# Appends every alert as JSONL. Useful as a CI artifact.
ALERT_FILE_SINK=

# ---------------------------------------------------------------------------
# Pipeline tuning — all optional, defaults shown
# ---------------------------------------------------------------------------

# Comma-separated; blank means every supported chain.
PROVENANCE_CHAINS=
# Tokens that get the full chain + LLM treatment each run.
MAX_TOKENS_PER_RUN=15
MIN_LIQUIDITY_USD=25000
MIN_VOLUME_24H_USD=100000
# Younger pools have no provenance worth researching yet.
MIN_POOL_AGE_HOURS=2
# Reuse a stored report inside this window; what keeps twice-daily runs cheap.
REANALYSE_AFTER_HOURS=72
ALERT_SCORE_THRESHOLD=70
DRY_RUN=false
# Run entirely from fixtures: no network, no API key.
USE_FIXTURES=false
LOG_LEVEL=info
PROVENANCE_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Sources — toggles and per-source limits
# ---------------------------------------------------------------------------

SOURCE_DEXTOOLS=true
SOURCE_DEXTOOLS_LIMIT=30
SOURCE_DEXTOOLS_RATE_MS=2500
SOURCE_DEXSCREENER=true
SOURCE_DEXSCREENER_LIMIT=30
SOURCE_DEXSCREENER_RATE_MS=1200
SOURCE_GECKOTERMINAL=true
SOURCE_GECKOTERMINAL_LIMIT=30
SOURCE_GECKOTERMINAL_RATE_MS=2200
# Run the DexTools scraper headed, for debugging selectors.
PROVENANCE_HEADFUL=0

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------

LLM_MODEL=claude-opus-5
LLM_TRIAGE_MODEL=claude-sonnet-5
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2
# Hard ceiling per run. Once hit, market and chain data keep being collected
# and the model stops being called. Start low.
LLM_MAX_COST_USD_PER_RUN=5

# ---------------------------------------------------------------------------
# RPC endpoints — comma-separated, tried in order. Defaults are free public
# endpoints; supply your own if you have better ones.
# ---------------------------------------------------------------------------

RPC_SOLANA=https://api.mainnet-beta.solana.com
RPC_ETHEREUM=https://eth.llamarpc.com,https://rpc.ankr.com/eth
RPC_BASE=https://mainnet.base.org
RPC_BSC=https://bsc-dataseed.binance.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_POLYGON=https://polygon-rpc.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
